// joburg-seats: the seat law for saved readers' forecasts, as a Python Worker
// running the project's own src/reader_seats.py and the src/ modules it
// imports (montecarlo, seats and their imports; numpy from Pyodide).
// Reached ONLY through SEATS service bindings (joburg-forecasts, and the
// site's Worker joburg-whysoserious for link previews); it has no public
// route (workers_dev false, no routes).
//
// ⛔ NOT BUILT OR DEPLOYED. The .py files it runs are COPIED from ../../src by
// `node tools/sync_seats_py.mjs` (never retyped); until that copy is run,
// src/entry.py answers 501 and joburg-forecasts refuses saves with 503.
// Untested here: Python Workers need `pywrangler`/uv tooling not installed.
{
  "name": "joburg-seats",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  // /v1/card fetches the published draws from here, once per isolate
  // (src/entry.py). The site's Worker reaches this one through a SEATS
  // service binding for its link previews (src/worker.js), as joburg-forecasts
  // does for saved forecasts.
  "vars": { "SITE_ORIGIN": "https://joburg.whysoserious.city" }
}
