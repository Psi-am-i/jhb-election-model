# Local development secrets for `wrangler dev`: NAMES only; values live in this
# machine's Keychain (~/CLAUDE.md rule 4, ~/projects/SECRETS.md). Never use a
# .dev.vars file. CLOUDFLARE_INCLUDE_PROCESS_ENV makes wrangler dev pass these
# process variables to the Worker.
export CLOUDFLARE_INCLUDE_PROCESS_ENV=true

kc() { security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null; }
for name in SESSION_SIGNING_KEY TURNSTILE_SECRET \
            GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET \
            APPLE_SERVICE_ID APPLE_TEAM_ID APPLE_KEY_ID APPLE_PRIVATE_KEY \
            FACEBOOK_APP_ID FACEBOOK_APP_SECRET \
            X_CLIENT_ID X_CLIENT_SECRET \
            MICROSOFT_CLIENT_ID MICROSOFT_CLIENT_SECRET; do
  value="$(kc "JHB_FORECASTS_$name")"
  [ -n "$value" ] && export "$name=$value"
done
unset value name
